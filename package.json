{
  "name": "cyclone-sim",
  "version": "1.0.0-alpha.1.0.0",
  "description": "Cyclone Simulator is a web-based simulation experiment aiming to visualize the life cycles of weather events namely tropical cyclones.",
  "private": true,
  "scripts": {
    "start": "parcel serve src/index.html",
    "build": "parcel build src/index.html",
    "clean": "rm dist/* && rm .parcel-cache/*"
  },
  "targets": {
    "default": {
      "publicUrl": "/cyclone-sim/alpha"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monsoonjr99/cyclone-sim.git"
  },
  "keywords": [
    "cyclone",
    "simulation",
    "canvas",
    "web",
    "game"
  ],
  "author": "Ryan Lane (Monsoonjr99)",
  "bugs": {
    "url": "https://github.com/Monsoonjr99/cyclone-sim/issues"
  },
  "homepage": "https://github.com/Monsoonjr99/cyclone-sim#readme",
  "devDependencies": {
    "@parcel/transformer-image": "^2.16.4",
    "@types/luxon": "^3.7.6",
    "parcel": "^2.16.4"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  }
}
